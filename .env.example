# Local development database only. Matches docker-compose.yml; not for hosting.
DATABASE_URL=postgres://indexio:indexio-local-only@127.0.0.1:5432/indexio
# Replace both placeholders before use. Generate each with: openssl rand -base64 32
APP_PASSWORD=change-me
SESSION_SECRET=change-me
# false supports plain HTTP on localhost, including npm start.
COOKIE_SECURE=false
# Set true only if you intentionally want to fetch localhost or LAN resources.
ALLOW_PRIVATE_URLS=false
